# Backend environment variables for TriLens Document Intelligence.
# Copy this file to .env and adjust for your local setup.
#
# Both the FastAPI app and the Streamlit app call load_dotenv() on startup,
# so variables defined here are loaded automatically. Shell-exported variables
# take precedence over values in this file.

# ── OpenFlamingo ────────────────────────────────────────────────────────────
# Set to true to enable experimental query-driven document analysis.
# Requires additional model files (~7 GB) and significant memory.
TRILENS_OPEN_FLAMINGO_ENABLED=false

# Device to run OpenFlamingo on. Use "cuda" if a compatible GPU is available.
TRILENS_OPEN_FLAMINGO_DEVICE=cpu

# ── API ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
TRILENS_CORS_ORIGINS=http://localhost:3000

# ── Qdrant ──────────────────────────────────────────────────────────────────
# Qdrant vector database configuration.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=trilens_vectors_v1
QDRANT_TIMEOUT_SECONDS=10
QDRANT_EXACT_SEARCH=true

# ── Database ───────────────────────────────────────────────────────────────
# Path to the SQLite database file.
DATABASE_PATH=data/trilens.db
